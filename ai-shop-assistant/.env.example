# ============================================================
# AI 店长助手 — 环境变量示例
# 复制为 .env 并填写真实值（.env 已在 .gitignore 中）
# ============================================================

# ---- 数据库 ------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/ai_shop

# ---- 抖音开放平台 ------------------------------------------
# 在 https://developer.open-douyin.com/ 创建应用后获取
DOUYIN_APP_KEY=your_app_key
DOUYIN_APP_SECRET=your_app_secret
DOUYIN_ACCESS_TOKEN=your_access_token

# 本地开发：跳过抖音 API，使用内置模拟数据
# DOUYIN_MOCK=1

# ---- 阿里云灵积 (DashScope) / Qwen -------------------------
# 在 https://dashscope.aliyun.com/ 开通后获取
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-max            # 或 qwen-plus / qwen-turbo
QWEN_TEMPERATURE=0.3

# ---- 运行参数 -----------------------------------------------
SHOP_ID=SHOP_DEMO_001          # 抖音店铺 ID
REPORT_DAYS=7                  # 分析周期（天）
OUTPUT_DIR=output              # 报告输出目录
